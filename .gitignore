# ============== web/ — Angular-приложение ==============
# (base-часть генерируется Angular CLI; IDE/AI-блок — shared canonical)

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# ============================================================
# IDEs and editors — SHARED canonical block (identical in root +
# proto/ + web/ + server/ + certs/ of this workspace). Keep in sync.
# ============================================================

# JetBrains (IntelliJ IDEA / WebStorm / GoLand / PyCharm / Fleet / Rider)
.idea/
.fleet/

# Eclipse
.project
.classpath
.settings/

# Visual Studio Code  (whitelist: shareable project config)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Cloud9
.c9/

# Vim / Neovim swap files
*.swp
*.swo

# AI IDEs (Cursor / Windsurf)
.cursor/
.windsurf/

# AI pair-programmers / agent local session folders
.clawd/
.clawd-tmp/
.claude/
.codex/
.copilot/
.aider*
.trae/
.trae-cn/
.trae-aicr/
.devin/
.agents/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

